<?xml version="1.0" encoding="utf-8"?>
<!-- Vault data must never be extracted/backed up (PRD §49 privacy). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="keys" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="keys" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
